# Copy this file to keystore.properties (same folder) and fill it in.
# keystore.properties is ignored by git. Never commit it, and never commit the .jks file.
#
# storeFile is relative to android/app/. Keeping the keystore outside the project is safer:
#   storeFile=C:/Users/you/keys/capacity-desk-upload.jks
storeFile=../capacity-desk-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
